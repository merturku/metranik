# Üyelik (isteğe bağlı). İkisi de tanımlıysa "Giriş yap" arayüzü açılır.
# Supabase > Project Settings > API: Project URL ve anon (public) anahtar.
# service_role anahtarını ASLA buraya veya NEXT_PUBLIC_* değişkenine koymayın.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI asistan (isteğe bağlı, YALNIZ sunucu — NEXT_PUBLIC_ öneki KULLANMAYIN).
# Tanımlıysa menüde "AI Asistan" görünür; tanımsızken özellik tamamen kapalıdır.
ANTHROPIC_API_KEY=
# İsteğe bağlı model seçimi (varsayılan: claude-sonnet-5-5)
ANTHROPIC_MODEL=
